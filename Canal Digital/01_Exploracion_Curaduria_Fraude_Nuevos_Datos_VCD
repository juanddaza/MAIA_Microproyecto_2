pe(int)\n","    # Eliminamos la original para no tener datos duplicados\n","    df_limpio = df_limpio.drop(columns=[col_f[-1]])\n","\n","# --- B. MAPEO DEL DICCIONARIO DE TRANSACCIONES ---\n","diccionario_trx = {\n","    'AVPE': 'Pago PSE Persona Natural',\n","    'FDA-AUTH': 'Ingreso Portal Virtual',\n","    'FDA-CDIS': 'Cambio de Dispositivo',\n","    'AVTL': 'Transf. BdB a Aval',\n","    'AVTR': 'Transf. BdB a BdB',\n","    'AVTO': 'Transf. ACH',\n","    'BMTR': 'Transf. BdB movil',\n","    'BMTO': 'Transf. ACH movil',\n","    'AVPF': 'Pago servicios banca virtual',\n","    'BMTH': 'Transfiya BdB',\n","    'MOTD': 'Cambio Topes PSE',\n","    'BMRS': 'Autenticador Digital',\n","    'AVIT': 'Inscripcion Cuenta',\n","    'POWI': 'Compra con QR',\n","    'BMAV': 'Avance Banca Movil'\n","}\n","\n","# Buscamos la columna del código de transacción\n","col_cod =[c for c in df_limpio.columns if 'Codigo de Entidad' in c or 'Codigo' in c][0]\n","df_limpio['Tipo_Transaccion'] = df_limpio[col_cod].astype(str).str.strip().str.upper().map(diccionario_trx).fillna('OTRA_TRANSACCION')\n","\n","# --- C. EXTRACCIÓN DEL CONTEXTO TEMPORAL (MUY IMPORTANTE PARA IA) ---\n","# Buscamos la columna de la hora\n","col_hora =[c for c in df_limpio.columns if 'Hora Inicial' in c or 'Hora' in c][0]\n","\n","# Extraemos solo el número de la hora (0 a 23)\n","df_limpio['Hora_Numerica'] = pd.to_datetime(df_limpio[col_hora], errors='coerce').dt.hour\n","\n","# Creamos una variable Binaria (1 o 0): ¿Es Madrugada? (Riesgo altísimo de fraude)\n","df_limpio['Es_Madrugada'] = df_limpio['Hora_Numerica'].apply(lambda x: 1 if pd.notnull(x) and (x <= 5 or x >= 23) else 0)\n","\n","print(\"\\n✅ Ingeniería de características completada.\")\n","print(\"📊 Muestra de las nuevas columnas creadas para el entrenamiento:\")\n","print(df_limpio[['Tipo_Transaccion', 'Hora_Numerica', 'Es_Madrugada', 'FRAUDE_IA']].head())"],"metadata":{"id":"L_8d8n6vUgAo"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# ==============================================================================\n","# PASO 7: CORRECCIÓN DEL TIPO DE TRANSACCIÓN Y EXTRACCIÓN DE COMPORTAMIENTO\n","# ==============================================================================\n","print(\"🔍 1. Ajustando el tipo de transacción y creando variables de comportamiento...\")\n","\n","# 1. Corrección del Tipo de Transacción (Buscamos exactamente la palabra 'Transaccion')\n","col_transaccion =[c for c in df_limpio.columns if 'Transaccion' in c or 'Transacci' in c]\n","if col_transaccion:\n","    # Usamos el diccionario que ya definimos antes\n","    df_limpio['Tipo_Transaccion'] = df_limpio[col_transaccion[0]].astype(str).str.strip().str.upper().map(diccionario_trx).fillna('OTRA_TRANSACCION')\n","    print(f\"✅ Variable Tipo_Transaccion corregida usando la columna: {col_transaccion[0]}\")\n","\n","# 2. Rescate de Comportamiento (Frecuencia de Cuentas)\n","# En lugar del número de cuenta, medimos: \"¿Cuántas veces interactúa esta cuenta en el archivo?\"\n","# Un valor alto en poco tiempo es un fuerte indicador de anomalía/fraude\n","col_cuenta = [c for c in df_limpio.columns if 'Cuenta' in c and 'Origen' in c]\n","if col_cuenta:\n","    df_limpio['Frecuencia_Cuenta_Origen'] = df_limpio.groupby(col_cuenta[0])[col_cuenta[0]].transform('count')\n","    print(\"✅ Creada variable 'Frecuencia_Cuenta_Origen' (Patrones de ráfaga)\")\n","\n","# 3. Rescate Tecnológico (IPs)\n","# No nos sirve la IP cruda, pero nos sirve saber si \"Tiene una IP registrada\" o si está oculta\n","col_ip =[c for c in df_limpio.columns if 'IP' in c]\n","if col_ip:\n","    df_limpio['Tiene_IP_Valida'] = df_limpio[col_ip[0]].apply(lambda x: 0 if pd.isnull(x) or str(x).strip() in ['0', '0.0', 'nan'] else 1)\n","    print(\"✅ Creada variable 'Tiene_IP_Valida' (Seguridad tecnológica)\")\n","\n","# ==============================================================================\n","# PASO 8: PREVENCIÓN DE OVERFITTING (ELIMINACIÓN DE IDENTIFICADORES Y DATOS PERSONALES)\n","# ==============================================================================\n","print(\"\\n🛡️ 2. Eliminando variables de identificación (Nombres, IDs, Correos) para evitar Overfitting y cumplir Habeas Data...\")\n","\n","# Buscamos palabras clave que indican que es un dato personal o un ID único\n","palabras_clave_id = ['ID-', 'Nombre', 'Correo', 'Email', 'Telefono', 'Direccion', 'Usuario', 'Cuenta']\n","\n","# Encontramos las columnas que contengan alguna de estas palabras\n","cols_a_borrar =[]\n","for col in df_limpio.columns:\n","    # Ignoramos las que nosotros mismos acabamos de crear con mucho esfuerzo\n","    if col in ['Frecuencia_Cuenta_Origen']:\n","        continue\n","    # Si tiene una palabra prohibida, la marcamos para borrar\n","    if any(palabra.lower() in col.lower() for palabra in palabras_clave_id):\n","        cols_a_borrar.append(col)\n","\n","# Borramos esas columnas del dataset\n","df_limpio = df_limpio.drop(columns=cols_a_borrar)\n","\n","print(f\"✅ Se eliminaron {len(cols_a_borrar)} columnas de identificación directa.\")\n","print(f\"📊 Estado actual del Dataset: {df_limpio.shape[0]} filas y {df_limpio.shape[1]} variables útiles.\")\n","\n","# Verificamos cómo quedó el tipo de transacción ahora sí\n","print(\"\\nDistribución de Tipos de Transacción (Top 5):\")\n","print(df_limpio['Tipo_Transaccion'].value_counts().head())"],"metadata":{"id":"RfZoEyEC_grs","executionInfo":{"status":"ok","timestamp":1773840323889,"user_tz":300,"elapsed":356,"user":{"displayName":"Yeison Toro","userId":"16012291496137071235"}},"colab":{"base_uri":"https://localhost:8080/"},"outputId":"f3874fc2-6cb9-41f0-9c74-2535d9423672"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["🔍 1. Ajustando el tipo de transacción y creando variables de comportamiento...\n","✅ Variable Tipo_Transaccion corregida usando la columna: AFD -  Codigo de Transaccion\n","✅ Creada variable 'Frecuencia_Cuenta_Origen' (Patrones de ráfaga)\n","✅ Creada variable 'Tiene_IP_Valida' (Seguridad tecnológica)\n","\n","🛡️ 2. Eliminando variables de identificación (Nombres, IDs, Correos) para evitar Overfitting y cumplir Habeas Data...\n","✅ Se eliminaron 20 columnas de identificación directa.\n","📊 Estado actual del Dataset: 180300 filas y 93 variables útiles.\n","\n","Distribución de Tipos de Transacción (Top 5):\n","Tipo_Transaccion\n","Pago PSE Persona Natural    122501\n","Ingreso Portal Virtual       33133\n","Cambio de Dispositivo        11761\n","Transf. BdB a Aval            5819\n","Transf. BdB a BdB             2018\n","Name: count, dtype: int64\n"]}]},{"cell_type":"code","source":["# ==============================================================================\n","# PASO 9: LIMPIEZA DE FECHAS Y VARIABLES DE DINERO\n","# ==============================================================================\n","print(\"⏳ 1. Eliminando marcas de tiempo en texto (ya extrajimos el comportamiento horario)...\")\n","\n","# Borramos las fechas y horas originales en texto\n","cols_fechas =[c for c in df_limpio.columns if ('Fecha' in c or 'Hora' in c) and c not in ['Hora_Numerica', 'Es_Madrugada']]\n","df_limpio = df_limpio.drop(columns=cols_fechas, errors='ignore')\n","\n","print(\"🔢 2. Formateando variables de dinero (Montos y Saldos)...\")\n","# Buscamos columnas que hablen de plata\n","cols_dinero =[c for c in df_limpio.columns if any(palabra in c.upper() for palabra in ['MONTO', 'SALDO', 'VALOR'])]\n","for col in cols_dinero:\n","    df_limpio[col] = pd.to_numeric(df_limpio[col].astype(str).str.replace(',', '.'), errors='coerce').fillna(0)\n","print(f\"✅ Se detectaron y limpiaron {len(cols_dinero)} variables financieras.\")\n","\n","# ==============================================================================\n","# PASO 10: PROTECCIÓN DE MEMORIA RAM Y ONE-HOT ENCODING SEGÚRO\n","# ==============================================================================\n","print(\"\\n🛡️ 3. Evaluando Cardinalidad para proteger la memoria RAM...\")\n","\n","cols_texto = df_limpio.select_dtypes(include=['object']).columns.tolist()\n","cols_a_codificar =[]\n","umbral_cardinalidad = 50 # Si tiene más de 50 categorías, asfixiará la RAM\n","\n","for col in cols_texto:\n","    num_unicos = df_limpio[col].nunique()\n","    if num_unicos > umbral_cardinalidad:\n","        print(f\"   🗑️ Eliminando '{col}': Tiene {num_unicos} valores distintos (Peligro de RAM/Overfitting).\")\n","        df_limpio = df_limpio.drop(columns=[col])\n","    else:\n","        # Si es segura, la rellenamos y la preparamos\n","        cols_a_codificar.append(col)\n","        df_limpio[col] = df_limpio[col].fillna('DESCONOCIDO').astype(str).str.strip().str.upper()\n","\n","print(f\"\\n✅ Columnas seguras para codificar: {len(cols_a_codificar)}\")\n","\n","print(\"\\n🔠 4. Convirtiendo variables de texto seguras a circuitos matemáticos (1 y 0)...\")\n","# Ahora sí aplicamos la magia de forma segura\n","df_listo = pd.get_dummies(df_limpio, columns=cols_a_codificar, drop_first=True)\n","\n","# En las versiones nuevas de Python, get_dummies devuelve booleanos. Las pasamos a 1 y 0.\n","for col in df_listo.columns:\n","    if df_listo[col].dtype == bool:\n","        df_listo[col] = df_listo[col].astype(int)\n","\n","# ==============================================================================\n","# PASO 11: GUARDAR EL DATASET MAESTRO EN DRIVE\n","# ==============================================================================\n","print(\"\\n💾 5. Guardando el Dataset Final en tu Google Drive...\")\n","\n","# Ruta donde lo guardaremos\n","ruta_salida = '/content/drive/MyDrive/Colab Notebooks/MAESTRIA IA/PROYECTO - DESARROLLO DE SOLUCIONES/dataset_limpio_IA.csv'\n","df_listo.to_csv(ruta_salida, index=False)\n","\n","print(f\"🚀 ¡PROCESO TERMINADO CON ÉXITO!\")\n","print(f\"📈 Dimensiones de la MATRIZ FINAL de entrada para la IA: {df_listo.shape[0]} Transacciones x {df_listo.shape[1]} Variables Matemáticas.\")