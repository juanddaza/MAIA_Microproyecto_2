\n","print(\"\\n⚙️ 3. Ingeniería de Características (Comportamiento, Tiempo y Transacción)...\")\n","diccionario_trx = {\n","    'AVPE': 'Pago PSE Persona Natural', 'FDA-AUTH': 'Ingreso Portal Virtual',\n","    'FDA-CDIS': 'Cambio de Dispositivo', 'AVTL': 'Transf. BdB a Aval',\n","    'AVTR': 'Transf. BdB a BdB', 'AVTO': 'Transf. ACH',\n","    'BMTR': 'Transf. BdB movil', 'BMTO': 'Transf. ACH movil',\n","    'AVPF': 'Pago servicios banca virtual', 'BMTH': 'Transfiya BdB',\n","    'MOTD': 'Cambio Topes PSE', 'BMRS': 'Autenticador Digital',\n","    'AVIT': 'Inscripcion Cuenta', 'POWI': 'Compra con QR', 'BMAV': 'Avance Banca Movil'\n","}\n","\n","# Tipo Transacción\n","col_cod =[c for c in df_limpio.columns if 'Código' in c and 'Transacción' in c]\n","if col_cod:\n","    df_limpio['Tipo_Transaccion'] = df_limpio[col_cod[0]].astype(str).str.strip().str.upper().map(diccionario_trx).fillna('OTRA_TRANSACCION')\n","\n","# Contexto Temporal\n","col_hora =[c for c in df_limpio.columns if 'Hora' in c and 'Inicial' in c]\n","if col_hora:\n","    df_limpio['Hora_Numerica'] = pd.to_datetime(df_limpio[col_hora[0]].astype(str), errors='coerce').dt.hour\n","    df_limpio['Es_Madrugada'] = df_limpio['Hora_Numerica'].apply(lambda x: 1 if pd.notnull(x) and (x <= 5 or x >= 23) else 0)\n","\n","# Frecuencia de Cuenta (Ráfagas)\n","col_cuenta = [c for c in df_limpio.columns if 'Cuenta' in c and 'Origen' in c]\n","if col_cuenta:\n","    df_limpio['Frecuencia_Cuenta_Origen'] = df_limpio.groupby(col_cuenta[0])[col_cuenta[0]].transform('count')\n","\n","# IPs\n","col_ip = [c for c in df_limpio.columns if 'IP' in c]\n","if col_ip:\n","    df_limpio['Tiene_IP_Valida'] = df_limpio[col_ip[0]].apply(lambda x: 0 if pd.isnull(x) or str(x).strip() in ['0', '0.0', 'nan'] else 1)\n","\n","\n","print(\"\\n🛡️ 4. Prevención de Overfitting (Borrando IDs) y variables de dinero...\")\n","# Borrar IDs\n","palabras_clave_id =['ID-', 'Nombre', 'Correo', 'Email', 'Telefono', 'Direccion', 'Usuario', 'Cuenta']\n","cols_a_borrar =[c for c in df_limpio.columns if any(p.lower() in c.lower() for p in palabras_clave_id) and c != 'Frecuencia_Cuenta_Origen']\n","df_limpio = df_limpio.drop(columns=cols_a_borrar, errors='ignore')\n","\n","# Borrar fechas viejas\n","cols_fechas =[c for c in df_limpio.columns if ('Fecha' in c or 'Hora' in c) and c not in['Hora_Numerica', 'Es_Madrugada']]\n","df_limpio = df_limpio.drop(columns=cols_fechas, errors='ignore')\n","\n","# Arreglar dinero\n","cols_dinero =[c for c in df_limpio.columns if any(p in c.upper() for p in['MONTO', 'SALDO', 'VALOR'])]\n","for col in cols_dinero:\n","    df_limpio[col] = pd.to_numeric(df_limpio[col].astype(str).str.replace(',', '.'), errors='coerce').fillna(0)\n","\n","\n","print(\"\\n🔠 5. Protección de RAM y One-Hot Encoding...\")\n","cols_texto = df_limpio.select_dtypes(include=['object']).columns.tolist()\n","cols_a_codificar = []\n","\n","for col in cols_texto:\n","    if df_limpio[col].nunique() > 50:\n","        df_limpio = df_limpio.drop(columns=[col]) # Si tiene más de 50 categorías, explota la RAM\n","    else:\n","        cols_a_codificar.append(col)\n","        df_limpio[col] = df_limpio[col].fillna('DESCONOCIDO').astype(str).str.strip().str.upper()\n","\n","# Circuitos matemáticos (0 y 1)\n","df_listo = pd.get_dummies(df_limpio, columns=cols_a_codificar, drop_first=True)\n","for col in df_listo.columns:\n","    if df_listo[col].dtype == bool:\n","        df_listo[col] = df_listo[col].astype(int)\n","\n","\n","print(\"\\n💾 6. Guardando el Dataset Final (1.4 Millones) en Google Drive...\")\n","ruta_salida = '/content/drive/MyDrive/Colab Notebooks/MAESTRIA IA/PROYECTO - DESARROLLO DE SOLUCIONES/dataset_limpio_IA.csv'\n","df_listo.to_csv(ruta_salida, index=False)\n","\n","print(f\"🚀 ¡PROCESO TERMINADO CON ÉXITO!\")\n","print(f\"📈 MATRIZ FINAL: {df_listo.shape[0]} Transacciones x {df_listo.shape[1]} Variables.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"nXlI3rO83jMs","executionInfo":{"