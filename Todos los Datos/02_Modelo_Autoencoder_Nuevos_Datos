 val_loss: 0.0012\n","Epoch 7/50\n","\u001b[1m469/469\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m2s\u001b[0m 3ms/step - loss: 0.0012 - val_loss: 0.0012\n","Epoch 8/50\n","\u001b[1m469/469\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m2s\u001b[0m 3ms/step - loss: 0.0012 - val_loss: 0.0012\n","Epoch 9/50\n","\u001b[1m469/469\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m1s\u001b[0m 3ms/step - loss: 0.0012 - val_loss: 0.0012\n","Epoch 10/50\n","\u001b[1m469/469\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m2s\u001b[0m 3ms/step - loss: 0.0011 - val_loss: 0.0012\n","Epoch 11/50\n","\u001b[1m469/469\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m2s\u001b[0m 4ms/step - loss: 0.0011 - val_loss: 0.0012\n","Epoch 12/50\n","\u001b[1m469/469\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m2s\u001b[0m 4ms/step - loss: 0.0011 - val_loss: 0.0012\n","Epoch 13/50\n","\u001b[1m469/469\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m2s\u001b[0m 4ms/step - loss: 0.0012 - val_loss: 0.0012\n","Epoch 14/50\n","\u001b[1m469/469\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m1s\u001b[0m 3ms/step - loss: 0.0012 - val_loss: 0.0012\n","Epoch 15/50\n","\u001b[1m469/469\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m3s\u001b[0m 3ms/step - loss: 0.0012 - val_loss: 0.0012\n","Epoch 16/50\n","\u001b[1m469/469\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m1s\u001b[0m 3ms/step - loss: 0.0012 - val_loss: 0.0012\n","Epoch 17/50\n","\u001b[1m469/469\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m2s\u001b[0m 3ms/step - loss: 0.0012 - val_loss: 0.0012\n","Epoch 17: early stopping\n","Restoring model weights from the end of the best epoch: 12.\n","\n","📊 3. Graficando la curva de aprendizaje (Error de reconstrucción)...\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# ==============================================================================\n","# PASO 7: RECONSTRUCCIÓN Y CÁLCULO DE ERRORES (LA PRUEBA DE FUEGO)\n","# ==============================================================================\n","import matplotlib.pyplot as plt\n","from sklearn.metrics import precision_recall_curve, auc, f1_score, recall_score, matthews_corrcoef, confusion_matrix\n","import seaborn as sns\n","import numpy as np\n","\n","print(\"🔍 1. Pasando datos normales y FRAUDES por el Autoencoder...\")\n","\n","# Reconstruimos los datos\n","reconstruccion_normal = autoencoder.predict(X_val_normal, verbose=0)\n","reconstruccion_fraude = autoencoder.predict(X_fraude, verbose=0)\n","\n","# Calculamos el Error Cuadrático Medio (MSE) por cada transacción\n","mse_normal = np.mean(np.power(X_val_normal - reconstruccion_normal, 2), axis=1)\n","mse_fraude = np.mean(np.power(X_fraude - reconstruccion_fraude, 2), axis=1)\n","\n","# ==============================================================================\n","# PASO 8: DEFINIR EL UMBRAL (EL RELÉ DE PROTECCIÓN)\n","# ==============================================================================\n","print(\"\\n⚡ 2. Ajustando el relé de protección (Umbral al 95%)...\")\n","umbral = np.percentile(mse_normal, 95)\n","print(f\"✅ Umbral de disparo establecido en MSE = {umbral:.6f}\")\n","\n","# ==============================================================================\n","# PASO 9: VISUALIZACIÓN DE LA SEPARACIÓN\n","# ==============================================================================\n","print(\"\\n📊 3. Graficando la diferencia de errores (Normal vs Fraude)...\")\n","plt.figure(figsize=(10,6))\n","plt.hist(mse_normal, bins=50, alpha=0.6, color='blue', label='Transacciones Normales')\n","plt.hist(mse_fraude, bins=50, alpha=0.6, color='red', label='FRAUDES')\n","plt.axvline(umbral, color='orange', linestyle='dashed', linewidth=2, label=f'Umbral = {umbral:.6f}')\n","plt.title('Distribución del Error de Reconstrucción (Autoencoder - Big Data)')\n","plt.xlabel('Error (MSE)')\n","plt.ylabel('Cantidad de Transacciones (Escala Logarítmica)')\n","plt.yscale('log')\n","plt.legend()\n","plt.show()\n","\n","# ==============================================================================\n","# PASO 10: EVALUACIÓN Y MÉTRICAS FINALES\n","# ==============================================================================\n","print(\"\\n📈 4. Calculando las métricas de desempeño definitivas...\")\n","\n","y_true = np.append(np.zeros(len(mse_normal)), np.ones(len(mse_fraude)))\n","mse_total = np.append(mse_normal, mse_fraude)\n","y_pred = (mse_total > umbral).astype(int)\n","\n","# AUPRC\n","precision, recall, _ = precision_recall_curve(y_true, mse_total)\n","auprc = auc(recall, precision)\n","\n","print(\"-\" * 50)\n","print(\"🏆 RESULTADOS FINALES DEL AUTOENCODER (BIG DATA):\")\n","print(\"-\" * 50)\n","print(f\"🔸 AUPRC (Métrica Prioritaria): {auprc:.4f}\")\n","print(f\"🔸 Recall (Fraudes reales detectados): {recall_score(y_true, y_pred):.2%}\")\n","print(f\"🔸 F1-Score: {f1_score(y_true, y_pred):.4f}\")\n","print(f\"🔸 Coeficiente de Matthews (MCC): {matthews_corrcoef(y_true, y_pred):.4f}\")\n","print(\"-\" * 50)\n","\n","# Matriz de Confusión\n","cm = confusion_matrix(y_true, y_pred)\n","print(\"\\n🚨 IMPACTO EN EL NEGOCIO (Sobre 60k Normales y 1.5k Fraudes):\")\n","print(f\"✔️ Clientes sanos que pasaron sin problema: {cm[0][0]}\")\n","print(f\"⚠️ Falsos Positivos (Clientes sanos molestados): {cm[0][1]}\")\n","print(f\"❌ Falsos Negativos (Fraudes que se nos escaparon): {cm[1][0]}\")\n","print(f\"🎯 FRAUDES DETECTADOS Y BLOQUEADOS: {cm[1][1]}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":886},"id":"FngFAMGIATMy","executionInfo":{"status":"ok","timestamp":17