al_escalado = scaler.fit_transform(df_normal.values)\n","# Escalamos el fraude con las mismas reglas\n","X_fraude_escalado = scaler.transform(df_fraude.values)\n","\n","# --- DESTRUCCIÓN DE VARIABLES GIGANTES PARA LIBERAR RAM ---\n","del df\n","del df_normal\n","del df_fraude\n","gc.collect() # Obligamos a Google Colab a vaciar la papelera de RAM inmediatamente\n","print(\"🧹 Memoria RAM liberada con éxito.\")\n","\n","print(\"\\n🔬 4. Creando conjunto de entrenamiento y validación...\")\n","X_train_normal, X_val_normal = train_test_split(X_normal_escalado, test_size=0.2, random_state=42)\n","\n","# Renombramos para compatibilidad con tu código de abajo\n","X_fraude = X_fraude_escalado\n","\n","print(f\"✅ Transacciones NORMALES para entrenamiento: {X_train_normal.shape[0]}\")\n","print(f\"✅ Transacciones NORMALES para validación: {X_val_normal.shape[0]}\")\n","print(f\"🚨 Transacciones de FRAUDE (¡TODAS!) reservadas para la prueba: {X_fraude.shape[0]}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"gaYQBm_V-M0Q","executionInfo":{"status":"ok","timestamp":1775867922489,"user_tz":300,"elapsed":39372,"user":{"displayName":"Yeison Toro","userId":"16012291496137071235"}},"outputId":"c287c747-2e4c-4130-83c3-647cfc45bbd8"},"execution_count":1,"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive\n","🚀 1. Cargando la matriz gigante optimizando la memoria RAM...\n","\n","⚙️ 2. Separando el Fraude...\n","📏 3. Escalando los datos...\n","🧹 Memoria RAM liberada con éxito.\n","\n","🔬 4. Creando conjunto de entrenamiento y validación...\n","✅ Transacciones NORMALES para entrenamiento: 240000\n","✅ Transacciones NORMALES para validación: 60000\n","🚨 Transacciones de FRAUDE (¡TODAS!) reservadas para la prueba: 1585\n"]}]},{"cell_type":"code","source":["# ==============================================================================\n","# PASO 4: ARQUITECTURA DEL AUTOENCODER (DEEP LEARNING)\n","# ==============================================================================\n","from tensorflow.keras.models import Model\n","from tensorflow.keras.layers import Input, Dense\n","from tensorflow.keras.callbacks import EarlyStopping\n","import matplotlib.pyplot as plt\n","\n","print(\"🏗️ 1. Construyendo la arquitectura de la Red Neuronal (Autoencoder)...\")\n","\n","# Cuántas variables entran (Ahora son 169)\n","input_dim = X_train_normal.shape[1]\n","\n","# --- A. EL ENCODER (Transformador Reductor) ---\n","input_layer = Input(shape=(input_dim,), name=\"Entrada\")\n","encoded = Dense(64, activation='relu', name=\"Compresion_64\")(input_layer)\n","encoded = Dense(32, activation='relu', name=\"Compresion_32\")(encoded)\n","encoded = Dense(16, activation='relu', name=\"Cuello_Botella_16\")(encoded) # Núcleo ultra-comprimido\n","\n","# --- B. EL DECODER (Transformador Elevador) ---\n","decoded = Dense(32, activation='relu', name=\"Reconstruccion_32\")(encoded)\n","decoded = Dense(64, activation='relu', name=\"Reconstruccion_64\")(decoded)\n","output_layer = Dense(input_dim, activation='sigmoid', name=\"Salida\")(decoded)\n","\n","# --- C. ENSAMBLAJE ---\n","autoencoder = Model(inputs=input_layer, outputs=output_layer, name=\"Autoencoder_Fraude_BigData\")\n","autoencoder.compile(optimizer='adam', loss='mse')\n","autoencoder.summary()\n","\n","# ==============================================================================\n","# PASO 5: ENTRENAMIENTO DE LA RED NEURONAL\n","# ==============================================================================\n","print(\"\\n🧠 2. Iniciando el entrenamiento con 240,000 transacciones NORMALES...\")\n","\n","early_stopping = EarlyStopping(monitor='val_loss', patience=5, restore_best_weights=True, verbose=1)\n","\n","historia = autoencoder.fit(\n","    X_train_normal, X_train_normal,\n","    epochs=50,\n","    batch_size=512, # Paquetes más grandes para procesar más rápido\n","    validation_data=(X_val_normal, X_val_normal),\n","    callbacks=[early_stopping],\n","    verbose=1\n",")\n","\n","# ==============================================================================\n","# PASO 6: GRAFICAR EL APRENDIZAJE\n","# ==============================================================================\n","print(\"\\n📊 3. Graficando la curva de aprendizaje (Error de reconstrucción)...\")\n","\n","plt.figure(figsize=(10, 6))\n","plt.plot(historia.history['loss'], label='Error de Entrenamiento (Train Loss)', color='blue')\n","plt.plot(historia.history['val_loss'], label='Error de Validación (Val Loss)', color='orange')\n","plt.title('Curva de Aprendizaje del Autoencoder (Big Data)')\n","plt.xlabel('Épocas (Vueltas de entrenamiento)')\n","plt.ylabel('Error Cuadrático Medio (MSE)')\n","plt.legend()\n","plt.grid(True)\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"uxJagTh7_d9z","executionInfo":{"status":"ok","timestamp":1775868234212,"user_tz":300,"elapsed":43783,"user":{"displayName":"Yeison Toro","userId":"16012291496137071235"}},"outputId":"691c6465-1c7b-4c8b-e13f-45da8b898965"},"execution_count":2,"outputs":[{"output_type":"stream","name":"stdout","text":["🏗️ 1. Construyendo la arquitectura de la Red Neuronal (Autoencoder)...\n"]},{"output_type":"display_data","data":{"text/plain":["\u001b[1mModel: \"Autoencoder_Fraude_BigData\"\u001b[0m\n"],"text/html":["<pre style=\"white-space:pre;overflow-x:auto;line-height:normal;font-family:Menlo,'DejaVu Sans Mono',consolas,'Courier New',monospace\"><span style=\"font-weight: bold\">Model: \"Autoencoder_Fraude_BigData\"</span>\n","</pre>\n"]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━┓\n","┃\u001b[1m \u001b[0m\u001b[1mLayer (type)                   \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mOutput Shape          \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1m      Param #\u001b[0m\u001b[1m \u001b[0m┃\n","┡━━━━━━━━━━━━━━━━━━━━━━